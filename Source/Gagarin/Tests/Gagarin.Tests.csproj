<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit tests for Piece A (provenance capture). ProvenanceGraph is
    deliberately free of any RimWorld dependency, so we compile its source file
    directly into a plain net8.0 NUnit project and drive it with synthetic
    System.Xml.XmlDocument inputs. This verifies the load-bearing pure logic
    (node keying + JSON serialization) without launching the game; the RimWorld
    plumbing in ProvenanceRecorder remains unverified until a real cold load.

    Run with: dotnet test Source/Gagarin/Tests/Gagarin.Tests.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
  </ItemGroup>

  <!-- Compile the real pure logic, not a copy. -->
  <ItemGroup>
    <Compile Include="..\Core\Incremental\ProvenanceGraph.cs" Link="ProvenanceGraph.cs" />
    <Compile Include="..\Core\Incremental\PatchIdWalker.cs" Link="PatchIdWalker.cs" />
    <Compile Include="..\Core\Incremental\DependencyGraphModel.cs" Link="DependencyGraphModel.cs" />
    <Compile Include="..\Core\Incremental\DirtySetComputer.cs" Link="DirtySetComputer.cs" />
    <Compile Include="..\Core\Incremental\SubDocExpander.cs" Link="SubDocExpander.cs" />
    <Compile Include="..\Core\Incremental\WildcardRematch.cs" Link="WildcardRematch.cs" />
    <Compile Include="..\Core\Incremental\UnifiedCacheDiff.cs" Link="UnifiedCacheDiff.cs" />
    <Compile Include="..\Core\Incremental\UnifiedCacheSplice.cs" Link="UnifiedCacheSplice.cs" />
    <Compile Include="..\Core\Incremental\MetricsLog.cs" Link="MetricsLog.cs" />
    <Compile Include="..\Core\Incremental\PriorStateSnapshotPaths.cs" Link="PriorStateSnapshotPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
